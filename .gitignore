# Settings file containing API keys
settings.json

# Data files: 2 master databases + 1 history.
# NOTE: no trailing comments on these lines - gitignore reads a whole line as
# one pattern, so "model_metadata.json  # Master 1" would never match the file.
model_metadata.json
node_metadata.json
download_history.json
usage_cache.json

# Deprecated data files, kept for backwards compatibility
search_cache.json
user_model_urls.json

# Machine-local cache, regenerated on demand
hf_candidate_cache.json

# Logs
wmd.log
wmd.log.*

# Local safety backups
_backup_*/

node.zip

# Throwaway progress notes. The real one is PROGRESS.md at the repo root and it IS tracked.
docs/PROGRESS-*.md
